diff --git a/src/arch/sys/syscall.S b/src/arch/sys/syscall.S
index 45df76c..c497dd5 100644
--- a/src/arch/sys/syscall.S
+++ b/src/arch/sys/syscall.S
@@ -12,19 +12,34 @@ sys_exit:
 .global syscall_handler
 .type syscall_handler, @function
 .extern syscall_table
-#define SYSCALL_NUMBER 2
+#define SYSCALL_NUMBER 12
 syscall_handler:
-	mov %rsp, %r12
+	mov %rsp, user_rps(%rip)
 	mov tss+4(%rip), %rsp
-	push %r12 // rsp
+	push user_rps(%rip)
 	push %r11 // rflags
 	push %rcx // rip
+	push %rdi
+	push %rsi
+	push %rdx
+	push %r8
+	push %r9
+	push %r10
+	sub $8, %rsp
 
 	cmp $SYSCALL_NUMBER, %rax
 	jae INVALID_SYSCALL
 
+	mov %r10, %rcx
 	call *syscall_table(,%rax, 8)
 
+	add $8, %rsp
+	pop %r10
+	pop %r9
+	pop %r8
+	pop %rdx
+	pop %rsi
+	pop %rdi
 	pop %rcx
 	pop %r11
 	pop %rsp
@@ -34,3 +49,8 @@ INVALID_SYSCALL:
 	//call proc_crash
 	hlt
 	jmp INVALID_SYSCALL
+
+.section .bss
+.align 8
+user_rps:
+	.skip 8
