diff --git a/src/sched/sched.c b/src/sched/sched.c
index babfd4f..a80c0bc 100644
--- a/src/sched/sched.c
+++ b/src/sched/sched.c
@@ -1,14 +1,22 @@
 #include "sched/proc.h"
 #include "proc_util.h"
 
+#define SCHED_MAX_PROCS 64
+
 // struct proc *current_proc = the current process
 struct proc *proc_sched()
 {
-	if (!current_proc) return hash_table_id_search(0);
-	struct proc *p0 = hash_table_id_search(0);
-	struct proc *p1 = hash_table_id_search(1);
-	if (current_proc->id == 0 && p1 && p1->state != PROC_DEAD) return p1;
-	if (current_proc->id == 1 && p0 && p0->state != PROC_DEAD) return p0;
-	if (current_proc->state != PROC_DEAD) return current_proc;
+	if (!current_proc)
+		return hash_table_id_search(0);
+
+	for (int step = 1; step <= SCHED_MAX_PROCS; step++) {
+		ushort id = (ushort)((current_proc->id + step) % SCHED_MAX_PROCS);
+		struct proc *p = hash_table_id_search(id);
+		if (p && p->state != PROC_DEAD && p->state != PROC_BLOCK)
+			return p;
+	}
+
+	if (current_proc->state != PROC_DEAD && current_proc->state != PROC_BLOCK)
+		return current_proc;
 	return NULL;
 }
